generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  CUSTOM
}

enum AmountUnit {
  GRAM
  SERVING
}

enum FoodSource {
  MANUAL
  OPEN_FOOD_FACTS
  LLM
}

enum BuddyStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ReactionType {
  THUMBS_UP
  THUMBS_DOWN
  FIRE
  MUSCLE
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile      Profile?
  logEntries   LogEntry[]
  workoutEntries WorkoutEntry[]
  weightEntries  WeightEntry[]
  waterEntries   WaterEntry[]

  buddyRequestsSent     BuddyRelationship[] @relation("Requester")
  buddyRequestsReceived BuddyRelationship[] @relation("Addressee")

  reactionsGiven         Reaction[]
  workoutReactionsGiven  WorkoutReaction[]
  logBatches             LogBatch[]
  savedMeals             SavedMeal[]
  sentMealProposals      MealProposal[] @relation("MealProposalSender")
  receivedMealProposals  MealProposal[] @relation("MealProposalRecipient")
  weeklyCheckIns         WeeklyCheckIn[]
  oauthConnections       OAuthConnection[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]

  @@index([username])
}

// OAuth credentials are opaque; only SHA-256 hashes are persisted.
model OAuthClient {
  id           String   @id @default(cuid())
  registrationKey String @unique
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())
  connections  OAuthConnection[]
  authorizationCodes OAuthAuthorizationCode[]
}

model OAuthConnection {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scopes    String[]
  resource  String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  accessTokens OAuthAccessToken[]
  refreshTokens OAuthRefreshToken[]
  @@index([userId, createdAt])
}

model OAuthAuthorizationCode {
  hash          String @id
  consentId     String @unique
  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scopes        String[]
  resource      String
  expiresAt     DateTime
  consumedAt    DateTime?
  @@index([expiresAt])
}

model OAuthAccessToken {
  hash         String @id
  connectionId String
  connection   OAuthConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  @@index([connectionId])
  @@index([expiresAt])
}

model OAuthRefreshToken {
  hash         String @id
  connectionId String
  connection   OAuthConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  consumedAt   DateTime?
  @@index([connectionId])
  @@index([expiresAt])
}

model OAuthRateLimit {
  key       String @id
  count     Int
  expiresAt DateTime
  @@index([expiresAt])
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  kcalTarget    Float    @default(2000)
  proteinTarget Float    @default(120)
  carbsTarget   Float    @default(250)
  fatTarget     Float    @default(70)
  fiberTarget   Float?   @default(30)

  heightCm        Float?
  weightKg        Float?
  age             Int?
  gender          String?
  equipmentPreset String?
  equipment       String[] @default([])

  allergies            String[] @default([])
  dietaryRestrictions  String[] @default([])
  healthConditions     String[] @default([])
  onboardingCompleted  Boolean  @default(false)
  cooperativeCheckInEnabled Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Food {
  id              String     @id @default(cuid())
  name            String
  brand           String?
  source          FoodSource @default(MANUAL)

  createdByUserId String?

  barcode         String?    @unique
  offUrl          String?
  offLastFetchedAt DateTime?

  kcalPer100g     Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  fiberPer100g    Float?
  sodiumMgPer100g Float?

  servingName     String?
  servingGrams    Float?
  // Null preserves legacy records; new verified gram-based foods use GRAMS.
  nutritionBasis  String?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  logEntries      LogEntry[]

  @@index([name])
}

model LogEntry {
  id             String     @id @default(cuid())

  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  date           String
  mealType       MealType
  mealName       String?

  amount         Float
  unit           AmountUnit @default(GRAM)

  sourceText     String?
  isEstimated    Boolean    @default(false)
  estimationMeta Json?

  snapshotKcal     Float?
  snapshotProteinG Float?
  snapshotCarbsG   Float?
  snapshotFatG     Float?
  snapshotFiberG   Float?

  foodId         String
  food           Food       @relation(fields: [foodId], references: [id], onDelete: Cascade)
  batchId        String?
  batch          LogBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  reactions      Reaction[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([date])
  @@index([userId, date])
  @@index([mealType, date])
  @@index([batchId])
}

model LogBatch {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String
  kind      String
  createdAt DateTime  @default(now())
  undoneAt  DateTime?
  entries   LogEntry[]

  @@unique([userId, requestId])
  @@index([userId, createdAt])
}

model SavedMeal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  pinned    Boolean  @default(true)
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, pinned])
}

model MealProposal {
  id              String   @id @default(cuid())
  senderId        String
  recipientId     String
  sender          User     @relation("MealProposalSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient       User     @relation("MealProposalRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  senderRequestId String
  name            String
  date            String
  mealType        MealType
  items           Json
  status          String   @default("PENDING")
  acceptedBatchId String?
  createdAt       DateTime @default(now())
  respondedAt     DateTime?

  @@unique([senderId, senderRequestId])
  @@index([recipientId, status])
}

model WeeklyCheckIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart String
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

model BuddyRelationship {
  id          String      @id @default(cuid())
  requesterId String
  addresseeId String
  status      BuddyStatus @default(PENDING)

  requester   User        @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User        @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Reaction {
  id         String       @id @default(cuid())
  logEntryId String
  userId     String
  type       ReactionType

  logEntry   LogEntry     @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime     @default(now())

  @@unique([logEntryId, userId, type])
  @@index([logEntryId])
  @@index([userId])
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  weightKg  Float
  date      String

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model WaterEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      String
  glasses   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model WorkoutEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date            String
  exerciseName    String
  muscleGroup     String?
  durationMinutes Float?
  sets            Int?
  reps            Int?
  weightKg        Float?

  caloriesBurned  Float
  isEstimated     Boolean  @default(false)
  sourceText      String?
  estimationMeta  Json?

  workoutReactions WorkoutReaction[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
  @@index([userId, date])
}

model WorkoutReaction {
  id             String       @id @default(cuid())
  workoutEntryId String
  userId         String
  type           ReactionType

  workoutEntry   WorkoutEntry @relation(fields: [workoutEntryId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())

  @@unique([workoutEntryId, userId, type])
  @@index([workoutEntryId])
  @@index([userId])
}
